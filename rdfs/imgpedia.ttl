@prefix : <http://imgpedia.dcc.uchile.cl/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix dbp: <http://dbpedia.org/ontology/> .
@prefix ogp: <http://ogp.me/ns#> .

# Ontology
: a owl:Ontology ;
    rdfs:label "The IMGpedia Ontology" .

# Classes
:Descriptor a owl:Class .

:ColorLayoutDescriptor a owl:Class ;
    rdfs:subClassOf :Descriptor .

:GrayHistogramDescriptor a owl:Class ;
    rdfs:subClassOf :Descriptor .

:HistogramOfOrientedGradient a owl:Class ;
    rdfs:subClassOf :Descriptor .

:Image a owl:Class ;
    rdfs:subClassOf schema:ImageObject, dbp:StillImage .

:ImageRelation a owl:Class .

# Object Properties
:appearsInWikipediaArticle a owl:ObjectProperty ;
    rdfs:domain :Image ;
    rdfs:range owl:Thing .

:relatedToDBpedia a owl:ObjectProperty ;
    rdfs:domain :Image ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf dbp:related .

:describesImage a owl:ObjectProperty ;
    rdfs:domain :Descriptor ;
    rdfs:range :Image .

:wikiCommonsURL a owl:ObjectProperty ;
    rdfs:domain :Image ;
    rdfs:subPropertyOf ogp:image .

:similarImage a owl:ObjectProperty ;
    rdfs:domain :Image ;
    rdfs:range :Image ;
    rdfs:subPropertyOf dbp:similar .

:sourceImage a owl:ObjectProperty ;
    rdfs:domain :ImageRelation ;
    rdfs:range :Image .

:targetImage a owl:ObjectProperty ;
    rdfs:domain :ImageRelation ;
    rdfs:range :Image .

:usedDescriptor a owl:ObjectProperty ;
    rdfs:domain :ImageRelation ;
    rdfs:range :Descriptor .

# Datatype Properties
:imageDistance a owl:DatatypeProperty ;
    rdfs:domain :ImageRelation ;
    rdfs:range xsd:float .

:height a owl:DatatypeProperty ;
    rdfs:domain :Image ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ogp:image:height, schema:height .

:width a owl:DatatypeProperty ;
    rdfs:domain :Image ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ogp:image:width, schema:width .

:descriptorValue a owl:DatatypeProperty ;
    rdfs:domain :Descriptor ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdf:value .